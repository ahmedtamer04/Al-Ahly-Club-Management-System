[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[submodule]
	active = .
[remote "origin"]
	url = https://github.com/nooreldeenamir/Al-Ahly.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[lfs]
	repositoryformatversion = 0
[branch "MA"]
	remote = origin
	merge = refs/heads/MA
	vscode-merge-base = origin/main
[branch "js"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/js
[branch "mostafa"]
	vscode-merge-base = origin/js
	remote = origin
	merge = refs/heads/mostafa
